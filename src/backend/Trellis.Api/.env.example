# devops_environments.md, "Configuration & Secrets Per Environment" — copy to `.env` (gitignored)
# and fill in real local values. This file documents the shape only; nothing here is a real
# secret. Nested keys use ASP.NET Core's double-underscore convention.

# ASP.NET Core's own framework-standard env vars — flat, not double-underscore, because these
# aren't app config read through our IConfiguration binding, they're read by the host itself
# before the app's configuration providers are even built.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
AllowedHosts=*

# App-wide, not module-specific, so flat rather than Modules__{X}__ (Core/Configuration/AppOptions.cs,
# CoreModuleExtensions.cs's CORS policy). AllowedOrigins is comma-separated — 5173 is `npm run
# dev`, 4173 is `npm run preview`, which Playwright's webServer (playwright.config.ts) builds
# and serves from for every `npm run test:e2e` run, so both need to be allowed for local dev.
AllowedOrigins=http://localhost:5173,http://localhost:4173
AppBaseUrl=http://localhost:5173

# Two connection strings, not one (data_model.md's Row-Level Security section explains why):
# the running API connects as the unprivileged trellis_app role so RLS actually applies;
# migrations (dotnet ef database update --context {Context} --connection "$TRELLIS_MIGRATIONS_CS")
# run as the privileged owner role instead. Both roles are created by
# infrastructure/init-app-role.sql the first time the local docker-compose Postgres initializes.
ConnectionStrings__Trellis=Host=localhost;Port=5432;Database=trellis_platform;Username=trellis_app;Password=trellis_app_dev_only
ConnectionStrings__TrellisMigrations=Host=localhost;Port=5432;Database=trellis_platform;Username=trellis;Password=trellis_dev_only

# security_guide.md's Secrets Management — read through ISecretProvider (Core/Secrets/), never a
# raw IConfiguration value. Flat names (no Modules__Auth__ prefix): ISecretProvider looks these
# up as a literal environment variable name, not through IConfiguration's nested-key convention.
#
# RS256 signing key, PKCS#8, base64-encoded. This one is a real, working dev-only keypair (not a
# placeholder) — generated for this repo, safe because nothing it signs protects real data.
# Regenerate for any environment beyond Local: `RSA.Create(2048).ExportPkcs8PrivateKey()`, base64.


# AES-256-GCM key for encrypting a user's TOTP secret at rest (security_guide.md's Encryption
# Architecture — single platform-level key, per-tenant isolation deferred). 32 random bytes,
# base64. Also a real, working dev-only value — regenerate for any environment beyond Local.
MfaEncryptionKeyBase64=LFSf47+F6M2r1CBs3aEJRxCaUzKTIQfqjvqSbaHhJsI=

# billing_design.md's Paystack webhook HMAC-SHA512 signature check — the one Paystack integration
# piece built for real this phase (PaystackGateway's own real HTTP calls are deferred; see its own
# doc comment). Not a real Paystack account's secret — a dev-only value, same as the two keys
# above, since NoOpPaymentGateway never calls Paystack for real. Regenerate for any environment
# beyond Local once a real Paystack account exists.
PaystackSecretKey=sk_test_dev_only_placeholder_not_a_real_paystack_key

# coding_standards.md's Configuration pattern — AuthOptions, all optional (defaults shown match
# security_guide.md's stated values; only set one here if actually overriding it for Local).
# Modules__Auth__AccessTokenExpiryMinutes=15
# Modules__Auth__RefreshTokenExpiryHours=8
# Modules__Auth__MfaPartialTokenExpiryMinutes=5
# Modules__Auth__PasswordResetTokenExpiryMinutes=30
# Modules__Auth__MfaRecoveryCodeCount=10
# Modules__Auth__FailedLoginLockoutThreshold=5
# Modules__Auth__FailedLoginLockoutWindowMinutes=15
# Modules__Auth__FailedLoginLockoutDurationMinutes=30
# Modules__Auth__RateLimitPermitLimit=10
# Modules__Auth__RateLimitWindowMinutes=5

# billing_design.md's Phase 1 usage-based rate (BillingOptions.PerUnitRate) — per active
# unit/asset, per billing period. Optional; the default (5.00) is used if unset.
# Modules__Billing__PerUnitRate=5.00

# coding_standards.md's Configuration pattern — ReportingOptions, all optional (defaults shown).
# Modules__Reporting__ShareLinkExpiryDays=14
# Modules__Reporting__WorkflowBottleneckThresholdDays=5

# coding_standards.md's Configuration pattern — LeasingOptions, all optional (defaults shown).
# Modules__Leasing__ApplicationLinkExpiryDays=7
# Modules__Leasing__MaxPhotosPerListing=12
