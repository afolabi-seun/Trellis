# devops_environments.md — copy to `.env` (gitignored) for local development. Vite only exposes
# variables prefixed VITE_ to client code (everything else stays server/build-only by design).
VITE_API_BASE_URL=http://localhost:5080

# Hosts the platform frontend itself is served from (comma-separated). When the app is opened on any
# other host it is treated as a tenant's own custom domain and resolved via the API. Defaults to
# localhost + 127.0.0.1 when unset; must match the API's PlatformHosts.
# VITE_PLATFORM_HOSTS=localhost,127.0.0.1,app.example.com
