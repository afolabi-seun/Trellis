root = true

# Universal rules — covers everything outside src/backend/ and src/frontend/ too (Handbook/
# Markdown, .github/workflows/*.yml, infrastructure/docker-compose.yml), so this stays at the
# repo root. src/backend/.editorconfig and src/frontend/.editorconfig each add their own
# language-specific rules on top of this one — EditorConfig merges nested files with their
# parents (unlike Directory.Build.props, which only takes the nearest one), so nothing here
# needs repeating in either.

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{json,yml,yaml}]
indent_size = 2
