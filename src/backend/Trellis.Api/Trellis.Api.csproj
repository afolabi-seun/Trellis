<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Trellis.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <!-- devops_environments.md, "Configuration & Secrets Per Environment": .env locally, the
         hosting platform's own env vars elsewhere — no appsettings.json in this codebase. -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <!-- coding_standards.md, "Application/Validators/{DtoName}Validator" -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />
    <!-- security_guide.md's JWT Bearer scheme (RS256) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <!-- security_guide.md's Argon2id password hashing -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- security_guide.md's TOTP MFA verification -->
    <PackageReference Include="Otp.NET" Version="1.4.0" />
    <!-- error_handling.md's Resilience for External Dependencies (Core/Resilience/ResiliencePolicies.cs) -->
    <PackageReference Include="Polly" Version="8.4.2" />
    <!-- Reporting module's Owner report PDF rendering (BDR-OWN-004) — pure managed .NET, no
         native/process dependency. Community license, free under $1M USD annual revenue; see
         QuestPdfOwnerReportRenderer's own doc comment for the license-threshold flag. -->
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
  </ItemGroup>

</Project>
