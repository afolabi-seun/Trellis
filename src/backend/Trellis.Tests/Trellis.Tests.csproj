<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Trellis.Tests</RootNamespace>
    <!--
      CA1707 (no underscores in identifiers) is suppressed here only — descriptive
      Scenario_ExpectedBehavior test names are more readable than PascalCase run together, and
      that readability matters more for tests than production code, where the rule stays on.

      CA1711 (type names ending in "Collection") is suppressed here only too — xUnit's own
      convention for a collection-fixture marker class (`[CollectionDefinition]`) is exactly
      `FooCollection : ICollectionFixture<Foo>`; fighting that with a different suffix would make
      the test project harder to read for anyone who already knows xUnit, not easier.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1711</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- testing_strategy.md's Test Pyramid: FluentAssertions for readability, NSubstitute for
         Service-layer unit tests, Testcontainers for the integration layer that proves RLS
         itself, not just app-layer logic against a mock. -->
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <!-- Phase 7's new API/Contract layer (testing_strategy.md's pyramid names it; this is the
         first test file to actually use it) — WebApplicationFactory<Program> for the webhook
         signature and module-entitlement 403/200 tests, which need a real HTTP pipeline/filter/
         auth stack, not just a mocked Service call. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trellis.Api\Trellis.Api.csproj" />
  </ItemGroup>

</Project>
